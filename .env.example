# Lokalni primer radi samo uz NODE_ENV=development i pristup preko localhost.
MANOJLO_LOCAL_DEMO=1
# Cloudflare koristi MANOJLO_STORAGE=d1 i MANOJLO_AUTH=google kroz wrangler.jsonc.
# Lokalno ih ne uključivati: razvojni režim koristi postojeću SQLite bazu.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Prva odobrena superadministratorska adresa; koristi se samo pri praznoj bazi.
MANOJLO_ADMIN_EMAIL=
APP_URL=http://localhost:3000
# Serverski Google servisni nalog; tabelu podeliti sa njegovom client_email adresom.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
# Alternativa: Google nalog sa pravom čitanja (ne mora biti vlasnik tabele).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# 32 nasumična bajta u Base64 formatu. Obavezno na objavljenom serveru.
# Lokalni razvoj automatski čuva ključ u .data/google-token.key.
GOOGLE_TOKEN_ENCRYPTION_KEY=
# Nasumična tajna za raspored sinhronizacije; ne šalje se pregledaču.
CRON_SECRET=
